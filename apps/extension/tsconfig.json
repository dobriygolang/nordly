{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@nordly-translate/*": ["../shared/translate/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts"]
}
