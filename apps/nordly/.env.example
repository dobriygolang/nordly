# Copy to `.env`:  cp .env.example .env

# Default: prod API (https://trynordly.app) via Vite proxy — no local backend needed.

# Direct API base (skip proxy). Usually leave unset in dev.
# VITE_NORDLY_API_BASE=http://localhost:8080

# Local-only data mode (default true): notes/tasks/focus stay on-device, cloud
# sync / Nordly login / publish stay off. Google Calendar + Zoom are separate —
# they use public OAuth client IDs below and OS Keychain (not LOCAL_ONLY).
# VITE_NORDLY_LOCAL_ONLY=false

# Device-owned Google Calendar (PKCE + Keychain). Desktop OAuth client; redirect
# is loopback http://127.0.0.1:<port>/ (registered as Desktop app). Scopes:
# calendar.events, calendar.calendarlist.readonly.
# VITE_GOOGLE_CLIENT_ID=

# Device-owned Zoom meetings (PKCE + Keychain). Redirect URI: nordly://settings
# Scopes: meeting:write:meeting user:read:user
# VITE_ZOOM_CLIENT_ID=

# Local microservices stack (identity, tracker, notes, focus):
# VITE_NORDLY_LOCAL_API=true

# Public web companion URL (optional — live/publish share URLs come from the API):
# VITE_NORDLY_WEB_BASE=https://trynordly.app
