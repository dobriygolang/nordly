{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowJs": true,
    "composite": true,
    "paths": {
      "@app/*": ["./src/renderer/src/app/*"],
      "@pages/*": ["./src/renderer/src/pages/*"],
      "@widgets/*": ["./src/renderer/src/widgets/*"],
      "@features/*": ["./src/renderer/src/features/*"],
      "@shared/*": ["./src/renderer/src/shared/*"],
      "@platform/*": ["./src/renderer/src/platform/*"],
      "@nordly-i18n": ["../shared/i18n"],
      "@nordly-i18n/*": ["../shared/i18n/*"],
      "@nordly-markdown": ["../shared/markdown"],
      "@nordly-markdown/*": ["../shared/markdown/*"],
      "@nordly-collab": ["../shared/collab"],
      "@nordly-collab/*": ["../shared/collab/*"],
      "yjs": ["./node_modules/yjs"],
      "y-protocols/awareness": ["./node_modules/y-protocols/awareness"],
      "react": ["./node_modules/@types/react/index.d.ts"]
    }
  },
  "include": [
    "src/renderer/**/*",
    "src/test/**/*",
    "../shared/i18n/**/*",
    "../shared/markdown/**/*",
    "../shared/collab/**/*",
    "../web/src/lib/markdown/renderNordlyMarkdown.ts"
  ],
  "exclude": ["out", "dist", "node_modules", "src-tauri/target"]
}
